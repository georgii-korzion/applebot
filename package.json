{
  "name": "apple-drop-assistant",
  "version": "3.0.0",
  "private": true,
  "description": "Chrome MV3 extension: pre-order assistant for apple.com/ae (stops before payment)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "watch": "node build.mjs --dev --watch",
    "typecheck": "tsc --noEmit",
    "hub": "node hub/server.mjs",
    "mock": "node test/mock-server.mjs",
    "test": "node build.mjs --unit && node --test dist-test/unit.test.mjs",
    "test:e2e": "node build.mjs --dev && node test/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.56.1",
    "typescript": "^5.6.0"
  }
}
