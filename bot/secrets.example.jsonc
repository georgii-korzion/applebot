// Секреты бота (docs/BOT-SPEC.md §5). Скопируй в корень репозитория как secrets.local.json, права 600:
//   cp bot/secrets.example.jsonc secrets.local.json && chmod 600 secrets.local.json
// Файл в .gitignore. После дропа — npm run bot -- wipe.
{
  // реальные люди, которые придут за заказом с документом; у каждого заказа — свой получатель
  "recipients": {
    "r1": { "firstName": "", "lastName": "", "email": "", "phone": "05XXXXXXXX" },
    "r2": { "firstName": "", "lastName": "", "email": "", "phone": "05XXXXXXXX" }
  },

  // primary раздаются заказам по кругу (maxOrders — сколько заказов можно оплатить картой);
  // reserve — только на замену карты, которую банк отклонил. Одну карту на двух Mac не ставь.
  "cards": [
    {
      "id": "c1", "label": "Карта 1", "role": "primary",
      "number": "", "expiry": "MM/YY", "cvv": "", "name": "",
      "billing": { "title": "", "firstName": "", "lastName": "", "street": "", "area": "", "town": "", "city": "Dubai" },
      "maxOrders": 2
    },
    {
      "id": "c2", "label": "Запасная", "role": "reserve",
      "number": "", "expiry": "MM/YY", "cvv": "", "name": "",
      "billing": { "title": "", "firstName": "", "lastName": "", "street": "", "area": "", "town": "", "city": "Dubai" },
      "maxOrders": 2
    }
  ],

  // статические резидентские или мобильные адреса ОАЭ; HTTP или SOCKS5, с логином
  "proxies": [
    { "id": "px1", "label": "AE-1", "url": "http://user:pass@host:port" },
    { "id": "px2", "label": "AE-2", "url": "socks5://user:pass@host:port" }
  ],

  // необязательно: заказы и так пишутся в runtime/orders.txt
  "telegram": { "botToken": "", "chatId": "", "allowedUserIds": [] },
  "webhooks": [{ "url": "", "secret": "" }]
}
